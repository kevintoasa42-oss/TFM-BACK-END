# Copia este archivo a jenkins/.env (no se sube a Git).
JENKINS_ADMIN_USER=admin
# Obligatoria: elige una clave propia (por ejemplo: openssl rand -hex 16).
JENKINS_ADMIN_PASSWORD=
JENKINS_PORT=8080
GITHUB_OWNER=kevintoasa42-oss
# Opcional: token de GitHub (solo lectura de repos públicos) para escanear PRs cada 2 minutos.
GITHUB_TOKEN=
# Docker Hub: usuario y Personal Access Token con permiso Read & Write.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
